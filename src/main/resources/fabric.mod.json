{
  "schemaVersion": 1,
  "id": "fabrictweaker",
  "version": "${version}",
  "name": "FabricTweaker",
  "description": "A client-side tweak mod that adds some useful feature to ${minecraft_version} client.",
  "authors": [
    "Crazy_H"
  ],
  "contact": {
    "website": "https://github.com/CrazyHPi/fabricTweaker",
    "repo": "https://github.com/CrazyHPi/FabricTweaker"
  },
  "license": "LGPL-3.0",
  "icon": "assets/fabrictweaker/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xyz.crazyh.fabrictweaker.FabricTweaker"
    ],
    "modmenu": [
      "xyz.crazyh.fabrictweaker.compact.modmenu.ModMenuImpl"
    ]
  },
  "accessWidener": "accesswideners/${aw_file}",
  "mixins": [
    "fabrictweaker.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}"
  }
}
